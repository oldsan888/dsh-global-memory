{
  "name": "@oldsan888/dsh-global-memory",
  "version": "0.2.0",
  "description": "Standalone DSH global long-term-memory bundle: durable SQLite memories, keyword/vector recall, and budgeted cross-session context.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldsan888/dsh-global-memory.git"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./storage-compat": "./lib/storage-compat.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-storage-sqlite": "0.1.1-rc.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-storage": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2 || 0.1.2-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-storage": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
